---
import ProjectListing from "@components/ProjectListing.astro";
import MainFlow from "@layouts/MainFlow.astro";
import { getEntry } from "astro:content";

const raincrow = await getEntry("projects", "raincrow");
const rba = await getEntry("projects", "rba");
const ebirdCompress = await getEntry("projects", "ebird-compress");
const birdsMakeSound = await getEntry("projects", "birds-make-sound");
const peep = await getEntry("projects", "peep");

---

<MainFlow title="Projects">
    <h1>Birding-related Projects 🦆</h1>
    <p>All of the bird tools in one place.</p>
    <ul class="flex flex-col gap-8">
        <ProjectListing project={raincrow} />
        <ProjectListing project={peep} />
        <ProjectListing project={rba} />
        <ProjectListing project={ebirdCompress} />
        <ProjectListing project={birdsMakeSound} />
    </ul>
    <p>
            <a href="/projects/">Back to all projects</a>
    </p>
</MainFlow>

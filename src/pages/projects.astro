---
import ProjectListing from "@components/ProjectListing.astro";
import MainFlow from "@layouts/MainFlow.astro";
import { getCollection, getEntry } from "astro:content";

const ccam = await getEntry("projects", "ccam");
const raincrow = await getEntry("projects", "raincrow");
const rba = await getEntry("projects", "rba");
const portfolio = await getEntry("projects", "portfolio");
const harmonicClouds = await getEntry("projects", "harmonic-clouds");
const evs = await getEntry("projects", "evs");
const ebirdCompress = await getEntry("projects", "ebird-compress");
const birdsMakeSound = await getEntry("projects", "birds-make-sound");
const happyPlants = await getEntry("projects", "happy-plants");
const peep = await getEntry('projects', 'peep');

---

<MainFlow title="Projects">
    <h1>Projects</h1>
    <p>🦆 = part of <a href="/projects/birding">birding projects</a></p>
    <ul class="flex flex-col gap-8">
        <ProjectListing project={raincrow} birdingProject={true} />
        <ProjectListing project={peep} birdingProject={true} />
        <ProjectListing project={happyPlants} />
        <ProjectListing project={rba} birdingProject={true}/>
        <ProjectListing project={ebirdCompress} birdingProject={true}/>
        <ProjectListing project={ccam} />
        <ProjectListing project={harmonicClouds} />
        <ProjectListing project={evs} />
        <ProjectListing project={birdsMakeSound} birdingProject={true}/>
        <ProjectListing project={portfolio} />
    </ul>
</MainFlow>
